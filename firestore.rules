rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.role in ['admin', 'superadmin'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsObject(objectId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/objects/$(objectId));
    }

    function isTokenOwnerOnCreate() {
      return isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    function isTokenOwner() {
      return isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();

      match /objects/{objectId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();

        match /checkins/{checkinId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if request.resource.data.keys().hasAll(['timestamp']) &&
            request.resource.data.timestamp != null;
          allow update, delete: if isOwner(userId) || isAdmin();
        }
      }
    }

    match /url_names/{urlName} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /object_status/{objectId} {
      allow read: if true;
      allow create, update, delete: if ownsObject(objectId) || isAdmin();
    }

    match /clicks/{clickId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if request.resource.data.keys().hasAll(['timestamp', 'type', 'objectId']) &&
        (!request.resource.data.keys().hasAny(['userId']) ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /fcm_tokens/{tokenId} {
      allow read: if isTokenOwner() || isAdmin();
      allow create: if isTokenOwnerOnCreate() || isAdmin();
      allow update, delete: if isTokenOwner() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // Deny any collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
