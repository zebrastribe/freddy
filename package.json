{
  "name": "freddy-location-tracker",
  "version": "1.0.0",
  "description": "A location tracking web application for Freddy the adventurous ginger cat",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "build": "echo 'No build step required - static site'",
    "deploy": "echo 'Deploy to GitHub Pages or Firebase Hosting'"
  },
  "keywords": [
    "location-tracking",
    "google-maps",
    "firebase",
    "pwa",
    "geolocation"
  ],
  "author": "Jesper",
  "license": "MIT",
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.1.4",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zebrastribe/freddy.git"
  },
  "bugs": {
    "url": "https://github.com/zebrastribe/freddy/issues"
  },
  "homepage": "https://zebrastribe.github.io/freddy"
}
