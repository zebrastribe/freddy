{
  "type": "module",
  "name": "trace-multi-user-platform",
  "version": "1.0.0",
  "description": "Multi-user, multi-pet platform with Node.js SPA server",
  "main": "spa-server.js",
  "scripts": {
    "preflight": "node ./scripts/preflight.cjs",
    "start": "node spa-server.js",
    "stack:start": "npm run preflight -- --lite && node start-trace.js",
    "stop": "node shutdown-trace.js",
    "stack:stop": "node shutdown-trace.js",
    "dev": "nodemon spa-server.js",
    "test": "npm run test:qa",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "npm --prefix tests test",
    "test:e2e:smoke": "npm --prefix tests run test:smoke",
    "test:qa": "npm run preflight -- --lite && npm run test:unit && npm run test:e2e:smoke",
    "security:rules:check": "node ./scripts/check-firestore-rules.cjs --mode=release",
    "health:local": "node ./scripts/health-local.cjs",
    "db:clean-exports": "node ./scripts/clean-firebase-exports.cjs",
    "build-css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./trace/v2-frontend/styles/tailwind-input.css -o ./trace/v2-frontend/public/styles/tailwind.css --watch --config ./trace/v2-frontend/tailwind.config.js",
    "emulators:start": "npm run preflight -- --lite && node start-emulators-with-users.js",
    "emu:add-url-names": "node trace/add-url-names.cjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.7.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "multi-user",
    "multi-pet",
    "spa",
    "firebase",
    "express"
  ],
  "author": "Trace Platform Team",
  "license": "MIT"
}
