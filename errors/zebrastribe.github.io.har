            "mimeType": "text/css",
            "text": "body, html {\n            margin: 0;\n            padding: 0;\n            height: 100%;\n            width: 100%;\n            display: flex;\n            justify-content: center;\n            /*align-items: center; */\n}\n\nh1 {\n            font-size: 10vw; /* The scaling of the font size */\n            margin: 0;\n            word-wrap: break-word;\n            text-align: center;\n            opacity: 0; /* Start with the text hidden */\n            transform: scale(0.8); /* Start slightly smaller */\n            animation: fadeInScale 1.5s ease-in forwards; /* Animation properties */\n}\n\n@keyframes fadeInScale {\nto {\n            opacity: 1; /* Fade in to full opacity */\n            transform: scale(1); /* Scale up to original size */\n   }\n}\n\n#map {\n            height: 400px;\n            width: 100%;\n}\n"
