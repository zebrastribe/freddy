{
  "name": "trace-notification-tests",
  "version": "1.0.0",
  "description": "Playwright tests for Trace notification system",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test e2e/simple-test.spec.js --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "install-browsers": "playwright install",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "playwright": "^1.40.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
} 